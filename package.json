{
  "name": "archivo-vivo-monorepo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "setup": "npm --prefix apps/desktop ci",
    "dev": "npm --prefix apps/desktop run tauri -- dev",
    "preview:ui": "npm --prefix apps/desktop run dev",
    "build:ui": "npm --prefix apps/desktop run build",
    "build:desktop": "npm --prefix apps/desktop run tauri -- build",
    "test:ui": "npm --prefix apps/desktop test",
    "test:core": "cargo test -p archivo-vivo-core",
    "lint": "npm --prefix apps/desktop run lint"
  }
}
